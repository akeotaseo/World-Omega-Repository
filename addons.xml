<addon
  id="skin.19MatrixWorld"
  version="1.1"
  name="Skin World-beta"
  provider-name="Helly,bsoriano,Diggz,Tk,Gb,ML,World,AI">
  <requires>
    <import addon="xbmc.gui" version="5.17.0"/>
    <import addon="script.favourites" version="8.1.2"/>
    <import addon="plugin.image.World" optional="true"/>
    <import addon="plugin.program.downloader19" optional="true"/>
    <import addon="plugin.program.downloaderstartup" optional="true"/>
    <import addon="plugin.program.mypreferences" optional="true"/>
    <import addon="plugin.program.myselect" optional="true"/>
    <import addon="plugin.program.simple.favourites" optional="true"/>
    <import addon="service.world.build" optional="true"/>
    <import addon="script.embuary.info" optional="true"/>
    <import addon="script.extendedinfo" optional="true"/>
    <import addon="script.sites" optional="true"/>
  </requires>
  <extension
    point="xbmc.gui.skin"
    debugging="false"
    effectslowdown="0.75">
    <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="el">Τροποποιημένο Xonfluence Skin για το World Build (Kodi Omega).</summary>
    <summary lang="en">eXtended MOD of Confluence skin for World Build (originally by Jezz_X and Mudislander).</summary>
    <description lang="el">Ειδικά διαμορφωμένο Skin βασισμένο στο Xonfluence, σχεδιασμένο για πλήρη παραμετροποίηση και άμεση πλοήγηση.[CR][CR][COLOR orange]Σημαντική Σημείωση:[/COLOR] Για να λειτουργήσουν σωστά όλες οι συντομεύσεις, τα widgets και οι καρτέλες του skin, απαιτούνται ορισμένα βασικά πρόσθετα (όπως TheMovieDb Helper, YouTube, script.favourites κ.ά.). Όλα τα απαραίτητα εργαλεία, πρόσθετα και υπηρεσίες θα τα βρείτε διαθέσιμα μέσα από το [B][COLOR gold]World Repository[/COLOR][/B] και μέσω του [B][COLOR orange]World Build[/COLOR][/B].</description>
    <description lang="en">Customised Xonfluence MOD skin designed for World Build.[CR][CR][COLOR orange]Note:[/COLOR] For full functionality of all shortcuts and widgets, essential addons (such as TheMovieDb Helper, YouTube, script.favourites, etc.) are required. All supporting tools and addons can be found in the [B][COLOR gold]World Repository[/COLOR][/B] and via [B][COLOR orange]World Build[/COLOR][/B].</description>
    <disclaimer lang="el">Η χρήση γίνεται με δική σας ευθύνη.</disclaimer>
    <disclaimer lang="en">You break it - You get to keep the pieces</disclaimer>
    <platform>all</platform>
    <license>GNU General Public License version 2</license>
    <forum>https://kodi.tv</forum>
    <website></website>
    <email></email>
    <source>https://github.com</source>
    <assets>
